{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow-first agent execution context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "workflow_id", "agent", "mode", "target", "live_state", "completion_contract_ref", "progress_ref", "project_state", "references", "permissions", "side_effects", "expected_outputs"],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1", "1.2", "1.3"] },
    "execution_id": { "type": "string", "pattern": "^EXEC-[0-9]{8}-[A-Z0-9-]+$" },
    "workflow_id": { "enum": ["implement-feature", "prepare-functional-spec"] },
    "track": { "enum": ["ba", "dev"] },
    "agent": { "enum": ["cap-business-analysis", "cap-solution", "cap-implementation", "cap-quality"] },
    "mode": { "enum": ["intake", "clarify", "draft", "reviewed", "rework", "plan", "implement", "self-review", "unit-test", "verify"] },
    "target": { "type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": { "type": { "const": "feature_implementation" }, "id": { "type": "string", "pattern": "^IMPL-[0-9]{3,}$" } } },
    "live_state": { "enum": ["intake", "clarify", "draft", "reviewed", "rework", "plan", "implement", "self-review", "unit-test", "verify"] },
    "run_intent": { "enum": ["fresh", "clean-replay"] },
    "prior_execution_policy": { "enum": ["none", "exclude-prior-output-use-prior-as-evaluation-only"] },
    "adapter_ref": { "type": "string", "description": "Legacy execution metadata. New executions must not set it." },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "required_human_action"],
      "properties": {
        "mode": { "const": "human-gated" },
        "required_human_action": { "const": "start-a-new-agent-session-and-confirm-dispatch" }
      }
    },
    "completion_contract_ref": { "type": "string" },
    "progress_ref": { "type": "string" },
    "project_state": { "type": "object" },
    "references": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["path", "purpose"], "properties": { "path": { "type": "string" }, "purpose": { "type": "string" }, "sections": { "type": "array", "items": { "type": "string" } } } } },
    "permissions": { "type": "object", "properties": { "read": { "type": "array", "items": { "type": "string" } }, "project_write": { "type": "array", "items": { "type": "string" } }, "generated_write": { "type": "array", "items": { "type": "string" } }, "execution_write": { "type": "array", "items": { "type": "string" } }, "agent_execution_write": { "type": "array", "items": { "type": "string" } }, "runtime_execution_write": { "type": "array", "items": { "type": "string" } }, "deny": { "type": "array", "items": { "type": "string" } }, "tools": { "type": "array", "items": { "type": "string" } } } },
    "side_effects": { "type": "object", "required": ["policy_ref", "classification_required"], "properties": { "policy_ref": { "type": "string" }, "classification_required": { "type": "boolean" } } },
    "expected_outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "prior_execution_outputs": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    { "if": { "properties": { "schema_version": { "const": "1.1" } } }, "then": { "required": ["run_intent", "prior_execution_policy"] } },
    { "if": { "properties": { "schema_version": { "const": "1.2" } } }, "then": { "required": ["run_intent", "prior_execution_policy", "routing"], "not": { "required": ["adapter_ref"] }, "properties": { "permissions": { "required": ["read", "project_write", "generated_write", "execution_write", "deny", "tools"] } } } },
    { "if": { "properties": { "schema_version": { "const": "1.3" } } }, "then": { "required": ["run_intent", "prior_execution_policy", "routing"], "not": { "required": ["adapter_ref"] }, "properties": { "permissions": { "required": ["read", "project_write", "generated_write", "agent_execution_write", "runtime_execution_write", "deny", "tools"], "not": { "required": ["execution_write"] } } } } },
    { "if": { "required": ["run_intent"], "properties": { "run_intent": { "const": "clean-replay" } } }, "then": { "required": ["prior_execution_outputs"], "properties": { "prior_execution_policy": { "const": "exclude-prior-output-use-prior-as-evaluation-only" }, "prior_execution_outputs": { "minItems": 1 } } } },
    { "if": { "required": ["run_intent"], "properties": { "run_intent": { "const": "fresh" } } }, "then": { "properties": { "prior_execution_policy": { "const": "none" } } } }
  ]
}

