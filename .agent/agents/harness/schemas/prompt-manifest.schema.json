{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compiled prompt manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "agent", "mode", "compiled_at", "precedence", "components", "completion_contract_ref", "loop_policy_ref", "output_schema_ref", "secrets_included"],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1", "1.2", "1.3"] },
    "execution_id": { "type": "string" },
    "agent": { "enum": ["cap-business-analysis", "cap-solution", "cap-implementation", "cap-quality"] },
    "mode": { "enum": ["intake", "clarify", "draft", "reviewed", "rework", "plan", "implement", "self-review", "unit-test", "verify"] },
    "compiled_at": { "type": "string", "format": "date-time" },
    "precedence": { "type": "array", "minItems": 1, "items": { "enum": ["system-safety", "project-governance", "agent-instructions", "shared-context", "state-skill", "execution-context", "loop-and-completion", "permissions", "summary-and-evaluation", "output-contract"] } },
    "components": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "ref", "sha256"], "properties": { "kind": { "type": "string" }, "ref": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } } } },
    "completion_contract_ref": { "type": "string" },
    "loop_policy_ref": { "type": "string" },
    "output_schema_ref": { "type": "string" },
    "secrets_included": { "const": false }
  }
}

