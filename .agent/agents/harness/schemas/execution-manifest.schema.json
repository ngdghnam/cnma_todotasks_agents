{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "workflow_id", "target", "live_state", "agent", "display_name", "agent_version", "mode", "manifest_ref", "enforcement_mode", "completion_contract_ref", "side_effect_policy_ref", "status", "created_at", "context_ref", "prompt_manifest_ref", "progress_ref", "result_ref", "evaluation_ref", "events_ref"],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1", "1.2", "1.3"] },
    "execution_id": { "type": "string", "pattern": "^EXEC-[0-9]{8}-[A-Z0-9-]+$" },
    "workflow_id": { "enum": ["implement-feature", "prepare-functional-spec"] },
    "track": { "enum": ["ba", "dev"] },
    "target": { "type": "object", "required": ["type", "id"], "properties": { "type": { "const": "feature_implementation" }, "id": { "type": "string", "pattern": "^IMPL-[0-9]{3,}$" } } },
    "live_state": { "enum": ["intake", "clarify", "draft", "reviewed", "rework", "plan", "implement", "self-review", "unit-test", "verify"] },
    "agent": { "enum": ["cap-business-analysis", "cap-solution", "cap-implementation", "cap-quality"] },
    "display_name": { "type": "string" },
    "agent_version": { "type": "string" },
    "mode": { "enum": ["intake", "clarify", "draft", "reviewed", "rework", "plan", "implement", "self-review", "unit-test", "verify"] },
    "run_intent": { "enum": ["fresh", "clean-replay"] },
    "supersedes_execution": { "type": "array", "items": { "type": "string" } },
    "prior_execution_policy": { "enum": ["none", "exclude-prior-output-use-prior-as-evaluation-only"] },
    "manifest_ref": { "type": "string" },
    "adapter_ref": { "type": "string", "description": "Legacy execution metadata. New executions must not set it." },
    "enforcement_mode": { "enum": ["manual-audited", "human-gated-manual-audited", "enforced"] },
    "routing_mode": { "enum": ["human-gated"] },
    "completion_contract_ref": { "type": "string" },
    "side_effect_policy_ref": { "type": "string" },
    "status": { "enum": ["prepared", "awaiting-human-dispatch", "acknowledged", "running", "awaiting-session-close", "closed", "completed", "completed-with-warnings", "paused", "blocked", "failed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "acknowledged_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": "string", "format": "date-time" },
    "session_closure_status": { "enum": ["required", "completed"] },
    "context_ref": { "type": "string" },
    "prompt_manifest_ref": { "type": "string" },
    "progress_ref": { "type": "string" },
    "result_ref": { "type": "string" },
    "evaluation_ref": { "type": "string" },
    "events_ref": { "type": "string" },
    "dispatch_brief_ref": { "type": "string" },
    "effective_permissions": { "type": "object" },
    "enforcement_profile": { "enum": ["orchestrated-v1", "orchestrated-v2", "orchestrated-v3"], "description": "Execution protocol marker. v3 adds runtime-owned canonical loop progress and an append-only ledger." },
    "loop_protocol_ref": { "type": "string" },
    "loop_state_ref": { "type": "string" },
    "loop_ledger_ref": { "type": "string" },
    "iteration_candidates_ref": { "type": "string" },
    "eligible_transition": { "type": ["string", "null"], "description": "Runtime-derived transitions.yml move id. It is a next-transition reference only, does not assert gate readiness, and is never applied by the runner." }
  },
  "allOf": [
    { "if": { "properties": { "schema_version": { "const": "1.1" } } }, "then": { "required": ["run_intent", "supersedes_execution", "prior_execution_policy"] } },
    { "if": { "properties": { "schema_version": { "const": "1.2" } } }, "then": { "required": ["run_intent", "supersedes_execution", "prior_execution_policy", "routing_mode", "dispatch_brief_ref", "session_closure_status"], "properties": { "routing_mode": { "const": "human-gated" }, "status": { "enum": ["awaiting-human-dispatch", "acknowledged", "running", "awaiting-session-close", "closed"] } }, "not": { "required": ["adapter_ref"] } } },
    { "if": { "properties": { "schema_version": { "const": "1.3" } } }, "then": { "required": ["run_intent", "supersedes_execution", "prior_execution_policy", "routing_mode", "dispatch_brief_ref", "session_closure_status", "loop_protocol_ref", "loop_state_ref", "loop_ledger_ref", "iteration_candidates_ref"], "properties": { "enforcement_profile": { "const": "orchestrated-v3" }, "routing_mode": { "const": "human-gated" }, "status": { "enum": ["awaiting-human-dispatch", "acknowledged", "running", "awaiting-session-close", "closed"] } }, "not": { "required": ["adapter_ref"] } } },
    { "if": { "required": ["run_intent"], "properties": { "run_intent": { "const": "clean-replay" } } }, "then": { "properties": { "prior_execution_policy": { "const": "exclude-prior-output-use-prior-as-evaluation-only" }, "supersedes_execution": { "minItems": 1 } } } },
    { "if": { "required": ["run_intent"], "properties": { "run_intent": { "const": "fresh" } } }, "then": { "properties": { "prior_execution_policy": { "const": "none" }, "supersedes_execution": { "maxItems": 0 } } } }
  ]
}

