{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Runtime-owned loop iteration candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_id", "attempt_id", "summary"],
  "properties": {
    "schema_version": { "const": "1.3" },
    "execution_id": { "type": "string" },
    "attempt_id": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "work_item_updates": { "type": "array", "items": { "$ref": "#/$defs/trackedUpdate" } },
    "acceptance_criteria_updates": { "type": "array", "items": { "$ref": "#/$defs/trackedUpdate" } },
    "test_updates": { "type": "array", "items": { "$ref": "#/$defs/testUpdate" } },
    "completion_check_updates": { "type": "array", "items": { "$ref": "#/$defs/checkUpdate" } },
    "validation_updates": { "type": "array", "items": { "$ref": "#/$defs/validationUpdate" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "evidenceRefs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "trackedUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence_refs"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["pending", "in-progress", "completed", "excluded", "blocked"] },
        "disposition": { "enum": ["implemented", "verified-no-change", "approved-exclusion", "blocked", "pending"] },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
        "notes": { "type": "string" }
      }
    },
    "testUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence_refs"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["pending", "verified", "blocked", "not-applicable"] },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" }
      }
    },
    "checkUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence_refs"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["pending", "pass", "fail", "blocked"] },
        "evidence_refs": { "$ref": "#/$defs/evidenceRefs" },
        "notes": { "type": "string" }
      }
    },
    "validationUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "evidence_ref"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["pending", "passed", "failed", "not-applicable", "blocked"] },
        "evidence_ref": { "type": ["string", "null"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "description"],
      "properties": {
        "severity": { "enum": ["blocking", "warning", "note"] },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "evidence": { "type": "string" },
        "next_action": { "type": "string" }
      }
    }
  }
}

