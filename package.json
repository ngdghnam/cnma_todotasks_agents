{
  "name": "cnma_todotasks",
  "version": "1.0.0",
  "description": "A simple CAP project to build with AI Agents",
  "scripts": {
    "start": "cds-serve",
    "watch": "cds-tsx watch",
    "deploy:sqlite": "cds deploy --to sqlite:db.sqlite",
    "typegen": "cds-typer \"*\" --outputDirectory @cds-models",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/qs": "^6.15.1",
    "rimraf": "^6.1.3",
    "tsx": "^4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-ai-sdk/ai-api": "^2.14.0",
    "@sap-ai-sdk/orchestration": "^2.14.0",
    "@sap-cloud-sdk/connectivity": "^4.8.0",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap/cds": "^10.0.5",
    "@sap/textbundle": "^6.2.0",
    "@sap/xssec": "^4",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "qs": "^6.15.3",
    "tsx": "^4"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "kind": "mocked",
        "users": {
          "admin": {
            "username": "admin",
            "password": "admin",
            "scopes": [
              "*"
            ]
          }
        }
      }
    },
    "todoAgents": {
      "maxReviewAttempts": 3,
      "maxParallelTasks": 2
    }
  }
}
